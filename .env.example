# Copy this to .env and fill in your values (see README.md for how to get each one).
# This app reads plain environment variables - use `export $(cat .env | xargs)`,
# a process manager, or your host's env var settings to load it.

# Register a free application at https://api.deriv.com (or the "Manage applications"
# page linked from developers.deriv.com) to get this.
APP_ID=

# Must exactly match the "Redirect URL" you set when registering the app above.
OAUTH_REDIRECT_URL=http://localhost:8080/auth/deriv/callback

# Deriv's classic OAuth login page - shouldn't need to change this.
DERIV_OAUTH_LOGIN_URL=https://oauth.deriv.com/oauth2/authorize

# Deriv's classic websocket API - shouldn't need to change this.
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# Local dev: run `docker compose up -d` and use this as-is.
DATABASE_URL=postgres://dsb:dsb@localhost:5432/deriv_signal_bot?sslmode=disable

# 32-byte AES-256 key, base64-encoded, used to encrypt Deriv tokens at rest.
# Generate one with: openssl rand -base64 32
APP_SECRET_KEY=

HTTP_ADDR=:8080

# Signal engine tuning - safe to leave as defaults until you've backtested.
DIGIT_WINDOW_SIZE=200
DIGIT_THRESHOLD_PCT=4.0
MOMENTUM_WINDOW_SIZE=20
MOMENTUM_THRESHOLD=0.65
